# Foundation backends (no trailing slash)
FOUNDATION_API_BASE_URL=https://your-api.example.com
FOUNDATION_WEB_BASE_URL=https://your-crm.example.com

# Optional static JWT override (usually skip — use dashboard Connect instead)
FOUNDATION_MONITOR_TOKEN=

# Prefer: Connect Foundation account in the dashboard UI.
# Password is not stored; access + refresh tokens are saved in Neon and refreshed each run.

# Google PageSpeed Insights API key (server-only)
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Protects POST/GET /api/run-checks (Vercel Cron + manual Run now)
CRON_SECRET=change-me

# Simple password gate for the dashboard UI (optional if using Vercel Deployment Protection)
DASHBOARD_PASSWORD=change-me

# Neon Postgres (preferred for v1 persistence)
# Create a free project at https://neon.tech and paste the connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Alternative: Vercel KV (only if you enable KV on the project)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
